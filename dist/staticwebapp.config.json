{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/modules/*",
      "/*.{css,js,json,ico,png,jpg,jpeg,svg,webp,woff,woff2,ttf}"
    ]
  },
  "trailingSlash": "never",
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
